// Prisma schema for POS System with Multi-outlet, Online Orders, Payment Gateway
// Domain: kamikamikita.site
// VPS: 137.59.126.116
// Routes: /kasir (POS interface), /admin (back office), /absensi (face attendance), /kds (kitchen display)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

// ==================== USER MANAGEMENT ====================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CASHIER
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  role          UserRole @default(CASHIER)
  phone         String?
  pin           String?  // 4-6 digit PIN untuk login kasir
  isActive      Boolean  @default(true)
  faceRegistered Boolean @default(false) // Status registrasi wajah
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  outletId     String?
  outlet       Outlet?   @relation("UserOutlet", fields: [outletId], references: [id])
  
  orders       Order[]   @relation("OrderCashier")
  createdOrders Order[]  @relation("OrderCreator")
  inventoryLogs Inventory[] @relation("InventoryCreator")
  
  // Face attendance relations
  employeeFace EmployeeFace?
  attendances  Attendance[]
  createdPromos Promo[] @relation("PromoCreator")

  @@index([email])
  @@index([outletId])
  @@map("users")
}

// ==================== OUTLET MANAGEMENT ====================

model Outlet {
  id            String   @id @default(cuid())
  name          String
  address       String?
  phone         String?
  email         String?
  taxRate       Decimal  @default(0.11) // PPN 11%
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  staff        User[]    @relation("UserOutlet")
  
  products     OutletProduct[]
  orders       Order[]
  inventory    Inventory[]
  customers    Customer[] @relation("CustomerOutlet")
  suppliers    Supplier[] @relation("SupplierOutlet")
  dailyReports DailyReport[]
  promos       Promo[]

  @@map("outlets")
}

// ==================== PRODUCT MANAGEMENT ====================

enum ProductCategory {
  FOOD
  BEVERAGE
  SNACK
  GROCERY
  ELECTRONICS
  CLOTHING
  OTHER
}

model Product {
  id            String         @id @default(cuid())
  sku           String         @unique
  name          String
  description   String?
  category      ProductCategory @default(OTHER)
  costPrice     Decimal        // Harga modal
  sellingPrice  Decimal        // Harga jual
  imageUrl      String?
  isActive      Boolean        @default(true)
  hasModifiers  Boolean        @default(false) // Apakah produk punya modifier (ukuran, es, gula, dll)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  outletProducts OutletProduct[]
  inventoryLogs  Inventory[]
  orderItems     OrderItem[]
  modifiers      ProductModifier[] // Modifier produk (extra es, less sugar, dll)

  @@index([sku])
  @@index([category])
  @@map("products")
}

// Product Modifiers (untuk kasir profesional)
model ProductModifier {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String   // Nama modifier (misal: "Ukuran", "Tingkat Gula")
  type        String   // "single" (pilih satu) atau "multi" (bisa pilih banyak)
  isRequired  Boolean  @default(false)
  sortOrder   Int      @default(0)
  options     ModifierOption[]

  @@index([productId])
  @@map("product_modifiers")
}

model ModifierOption {
  id            String   @id @default(cuid())
  modifierId    String
  modifier      ProductModifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  name          String   // Nama option (misal: "Large", "Extra Ice")
  priceAdjustment Decimal @default(0) // Penyesuaian harga (bisa positif/negatif)
  isDefault     Boolean  @default(false)
  sortOrder     Int      @default(0)

  @@index([modifierId])
  @@map("modifier_options")
}

model OutletProduct {
  id            String   @id @default(cuid())
  outletId      String
  productId     String
  currentStock  Int      @default(0)
  minStock      Int      @default(0)
  isAvailable   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  outlet        Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([outletId, productId])
  @@index([outletId])
  @@map("outlet_products")
}

// ==================== INVENTORY MANAGEMENT ====================

enum InventoryType {
  RESTOCK
  SALE
  DAMAGE
  RETURN
  ADJUSTMENT
}

model Inventory {
  id            String       @id @default(cuid())
  outletId      String
  productId     String
  type          InventoryType
  quantity      Int          // Positive for incoming, negative for outgoing
  previousStock Int
  currentStock  Int
  note          String?
  reference     String?      // Order ID, etc.
  createdAt     DateTime     @default(now())

  // Relations
  outlet        Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy     String
  creator       User         @relation("InventoryCreator", fields: [createdBy], references: [id])

  @@index([outletId, productId])
  @@index([createdAt])
  @@map("inventory")
}

// ==================== CUSTOMER MANAGEMENT ====================

model Customer {
  id            String   @id @default(cuid())
  outletId      String
  name          String
  email         String?
  phone         String?
  address       String?
  points        Int      @default(0)
  totalSpent    Decimal  @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  outlet        Outlet   @relation("CustomerOutlet", fields: [outletId], references: [id])
  orders        Order[]

  @@index([outletId])
  @@index([phone])
  @@map("customers")
}

// ==================== ORDER MANAGEMENT ====================

enum OrderType {
  DINE_IN
  TAKE_AWAY
  DELIVERY
  ONLINE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  ON_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIAL
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  QRIS
  BANK_TRANSFER
  GOPAY
  OVO
  DANA
  SHOPEEPAY
  OTHER
}

model Order {
  id              String        @id @default(cuid())
  outletId        String
  orderNumber     String        @unique
  type            OrderType     @default(DINE_IN)
  status          OrderStatus   @default(PENDING)
  tableNumber     String?       // Untuk dine-in
  customerName    String?       // Quick customer name
  customerPhone   String?       // Quick customer phone
  
  // Customer info
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  
  // Order details
  subtotal        Decimal
  taxAmount       Decimal
  discountAmount  Decimal       @default(0)
  tipAmount       Decimal       @default(0)
  totalAmount     Decimal
  
  // Payment info
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentMethod   PaymentMethod?
  paymentProof    String?       // For online payment
  paidAmount      Decimal       @default(0)
  changeAmount    Decimal       @default(0)
  
  // Additional info
  notes           String?
  deliveryAddress String?       // For delivery
  
  // Promo
  promoId         String?
  promo           Promo?        @relation(fields: [promoId], references: [id])
  
  // Timestamps
  orderDate       DateTime      @default(now())
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  outlet          Outlet         @relation(fields: [outletId], references: [id])
  cashierId       String?
  cashier         User?          @relation("OrderCashier", fields: [cashierId], references: [id])
  createdById     String?
  createdBy       User?          @relation("OrderCreator", fields: [createdById], references: [id])
  
  items           OrderItem[]
  payments        Payment[]
  kdsItems        KdsOrderItem[]

  @@index([outletId, orderDate])
  @@index([status])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String
  productName   String   // Snapshot of product name
  quantity      Int
  unitPrice     Decimal
  totalPrice    Decimal
  notes         String?  // Custom notes per item
  modifiers     Json?    // Array of selected modifiers [{modifierName, optionName, priceAdjustment}]

  // Relations
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id])
  kdsItems      KdsOrderItem[] // KDS items for this order item

  @@index([orderId])
  @@map("order_items")
}

// ==================== PAYMENT MANAGEMENT ====================

enum PaymentGateway {
  MIDTRANS
  XENDIT
  DUITKU
  MANUAL
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  gateway         PaymentGateway?
  gatewayRef      String?       // Reference ID from payment gateway
  method          PaymentMethod
  amount          Decimal
  status          String        // SUCCESS, PENDING, FAILED
  paidAt          DateTime?
  rawResponse     String?       // JSON response from gateway
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([gatewayRef])
  @@map("payments")
}

// ==================== PROMO MANAGEMENT ====================

enum PromoType {
  PERCENTAGE      // Diskon persentase
  FIXED_AMOUNT    // Diskon nominal tetap
  BUY_X_GET_Y     // Beli X gratis Y
  HAPPY_HOUR      // Happy hour diskon otomatis
  MEMBER_ONLY     // Khusus member
}

enum PromoStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

model Promo {
  id              String      @id @default(cuid())
  outletId        String
  name            String
  description     String?
  type            PromoType
  value           Decimal     // Nilai diskon (persentase atau nominal)
  minPurchase     Decimal     @default(0) // Minimal pembelian
  maxDiscount     Decimal?    // Maksimal diskon (untuk persentase)
  startDate       DateTime
  endDate         DateTime
  startTime       String?     // Format: "HH:mm" untuk happy hour
  endTime         String?     // Format: "HH:mm"
  status          PromoStatus @default(ACTIVE)
  usageLimit      Int?        // Limit penggunaan (null = unlimited)
  usageCount      Int         @default(0)
  promoCode       String?     @unique // Kode promo (opsional)
  applicableProducts String[] // Array of product IDs (kosong = semua produk)
  createdById     String?
  createdBy       User?       @relation("PromoCreator", fields: [createdById], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  outlet          Outlet      @relation(fields: [outletId], references: [id])
  orders         Order[]     // Orders using this promo

  @@index([outletId])
  @@index([status])
  @@map("promos")
}

// ==================== SUPPLIER MANAGEMENT ====================

model Supplier {
  id            String   @id @default(cuid())
  outletId      String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  outlet        Outlet   @relation("SupplierOutlet", fields: [outletId], references: [id])

  @@index([outletId])
  @@map("suppliers")
}

// ==================== FACE ATTENDANCE SYSTEM ====================

model EmployeeFace {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  faceDescriptor String   // JSON string dari face descriptor (128D vector)
  faceImageUrl  String?  // Foto wajah yang terdaftar
  confidence    Decimal  @default(0.8) // Threshold kecocokan (0-1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  attendances   Attendance[]

  @@map("employee_faces")
}

enum AttendanceType {
  CHECK_IN    // Masuk
  CHECK_OUT   // Pulang
}

enum AttendanceStatus {
  VALID       // Valid
  INVALID     // Tidak valid (wajah tidak cocok)
  PENDING     // Menunggu verifikasi
}

model Attendance {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeFaceId String?
  employeeFace EmployeeFace?    @relation(fields: [employeeFaceId], references: [id])
  
  type          AttendanceType
  timestamp     DateTime         @default(now())
  confidence    Decimal?         // Tingkat kecocokan wajah (0-1)
  imageUrl      String?          // Foto saat absensi
  location      String?          // IP address atau lokasi
  deviceInfo    String?          // User agent / device info
  status        AttendanceStatus @default(VALID)
  notes         String?
  verifiedBy   String?          // Admin yang verifikasi (jika pending)
  verifiedAt   DateTime?        // Waktu verifikasi

  @@index([userId, timestamp])
  @@map("attendances")
}

// ==================== KITCHEN DISPLAY SYSTEM (KDS) ====================

enum KdsItemStatus {
  NEW         // Pesanan baru
  PREPARING   // Sedang disiapkan
  READY       // Siap disajikan/diambil
}

model KdsOrderItem {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  status      KdsItemStatus @default(NEW)
  startedAt   DateTime?     // Waktu mulai prepare
  completedAt DateTime?     // Waktu selesai prepare
  notes       String?       // Catatan untuk dapur
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("kds_order_items")
}
// ==================== HELD BILLS (BILL GANTUNG) ====================

model HeldBill {
  id           String   @id @default(cuid())
  customerName String   @default("Tanpa Nama")
  tableNumber  String   @default("-")
  items        Json     // Menyimpan array item keranjang belanja
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("held_bills")
}

// ==================== REPORTS & ANALYTICS ====================

model DailyReport {
  id            String   @id @default(cuid())
  outletId      String
  date          DateTime
  totalOrders   Int      @default(0)
  totalRevenue  Decimal  @default(0)
  totalItems    Int      @default(0)
  averageOrder  Decimal  @default(0)
  totalDiscount Decimal  @default(0)
  totalTax      Decimal  @default(0)
  totalTips     Decimal  @default(0)
  createdAt     DateTime @default(now())

  // Relations
  outlet        Outlet   @relation(fields: [outletId], references: [id])

  @@unique([outletId, date])
  @@index([outletId, date])
  @@map("daily_reports")
}
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}